    <div id="root">
      <style>:root{--main-loader-bg:#190127;--main-loader-skeleton-color:linear-gradient(90deg, rgba(138, 202, 255, 0.08) 8%, rgba(138, 202, 255, 0.12) 16%, rgba(138, 202, 255, 0.08) 32%);--main-loader-caption-color:#a1a1a1}html{background-color:var(--main-loader-bg);scrollbar-gutter:stable}body{margin:0}.main-loader{display:flex;flex-direction:column;flex-grow:1}.main-loader__sidebar{display:none;width:68px;margin:8px 0 8px 8px;border-radius:20px;background:var(--main-loader-skeleton-color)}.main-loader_extended .main-loader__sidebar{width:272px;border-radius:24px}.main-loader__body{display:flex;flex-direction:column;flex-grow:1}.main-loader__header{display:flex;height:72px;align-items:center;justify-content:space-between;padding-block:16px 12px;padding-inline:16px}.main-loader__left{display:flex;align-items:center;height:100%}.main-loader__left-logo{display:none;height:36px;clip-path:url('#sprite:icon:skeleton-mask')}.main-loader__left-logo-mobile{height:36px;clip-path:url('#sprite:icon:skeleton-mask-compact')}.main-loader__main{position:relative;display:flex;flex-grow:1;align-items:center;justify-content:center}.main-loader__footer{position:fixed;right:var(--safe-area-inset-right);bottom:0;left:var(--safe-area-inset-left);display:flex;flex-direction:column}.main-loader__footer-tabbar-wrapper{display:flex;flex-direction:column;row-gap:8px;padding:8px 12px calc(max(var(--safe-area-inset-bottom),16px))}.main-loader__footer-tabbar{height:48px;border-radius:16px}.main-loader__footer-item-lines-wrapper{display:flex;justify-content:space-around;padding-bottom:2px}.main-loader__footer-item-line{width:41px;height:12px;border-radius:999px}.main-loader__skeleton{animation:1.8s main-loader-shine linear infinite;background:var(--main-loader-skeleton-color);background-size:200% 100%}.main-loader__user{display:flex;height:44px;border-radius:12px}.main-loader__user-balance{width:191px;flex-shrink:0;border-radius:8px;margin-left:12px}.main-loader__user-button{width:44px;height:44px;flex-shrink:0;border-radius:8px;margin-left:24px}.main-loader__main-logo{height:36px;mask-mode:alpha;mask-size:cover}.main-loader__main-logo-full{display:none;clip-path:url('#sprite:icon:skeleton-mask')}.main-loader__main-logo-mobile{clip-path:url('#sprite:icon:skeleton-mask-compact')}.main-loader__main-caption{position:absolute;bottom:194px;left:50%;color:var(--main-loader-caption-color);font-size:.5em;opacity:.25;transform:translateX(-50%)}@media (min-width:1024px){.main-loader{display:flex;flex-direction:row}.main-loader__sidebar{display:block}.main-loader__body{flex-grow:1;align-items:center;padding:0 24px}.main-loader__header{width:100%;height:84px;padding:0}.main-loader__left-logo-mobile{display:none}.main-loader__left-logo{display:block}.main-loader__user-balance{width:288px;height:44px;border-radius:12px;margin-left:16px}.main-loader__user-button{width:44px;height:44px;border-radius:12px;margin-left:12px}.main-loader__main-logo-full{display:block}.main-loader__main-logo-mobile{display:none}.main-loader__footer{display:none}}@keyframes main-loader-shine{0%{background-position-x:100%}56%{background-position-x:-100%}100%{background-position-x:-100%}}</style><div class="main-loader"><div class="main-loader__sidebar main-loader__skeleton"></div><div class="main-loader__body"><div class="main-loader__header"><div class="main-loader__left"><div class="main-loader__left-logo main-loader__skeleton"></div><div class="main-loader__left-logo-mobile main-loader__skeleton"></div></div><div class="main-loader__user"><div class="main-loader__user-balance main-loader__skeleton"></div><div class="main-loader__user-button main-loader__skeleton"></div></div></div><div class="main-loader__main"><div class="main-loader__main-logo main-loader__main-logo-full main-loader__skeleton"></div><div class="main-loader__main-logo main-loader__main-logo-mobile main-loader__skeleton"></div><div class="main-loader__main-caption"></div></div><div class="main-loader__footer"><div class="main-loader__footer-tabbar-wrapper"><div class="main-loader__footer-tabbar main-loader__skeleton"></div><div class="main-loader__footer-item-lines-wrapper"><div class="main-loader__footer-item-line main-loader__skeleton"></div><div class="main-loader__footer-item-line main-loader__skeleton"></div><div class="main-loader__footer-item-line main-loader__skeleton"></div><div class="main-loader__footer-item-line main-loader__skeleton"></div><div class="main-loader__footer-item-line main-loader__skeleton"></div></div></div></div></div></div><script>const mainLoader=document.querySelector(".main-loader");function applySize(e,o){const t=document.querySelector(e);if(t){const{height:e=0,width:i=0}=t.dataset;document.querySelector(o).style.aspectRatio=String(i/e)}}function getCookie(e){const o=document.cookie.match(new RegExp("(?:^|; )"+e.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g,"\\$1")+"=([^;]*)"));return o?decodeURIComponent(o[1]):void 0}if(mainLoader){"true"!==getCookie("compact_sidebar")&&mainLoader.classList.add("main-loader_extended"),applySize("#sprite\\:icon\\:skeleton-mask",".main-loader__left-logo"),applySize("#sprite\\:icon\\:skeleton-mask-compact",".main-loader__left-logo-mobile"),applySize("#sprite\\:icon\\:skeleton-mask",".main-loader__main-logo"),applySize("#sprite\\:icon\\:skeleton-mask-compact",".main-loader__main-logo-mobile")}setTimeout((()=>{const e=document.querySelector(".main-loader__main-caption"),o=window.INITIAL_DATA?.traceId;e&&o&&(e.textContent=o)}),window.INITIAL_DATA?.loaderSessionIdTimeoutMs??5e3)</script>
    </div>

